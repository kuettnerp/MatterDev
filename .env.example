# Copy this file to .env and adjust for your Pi.

# The Pi's wlan0 IP or hostname, used to build the HLS URLs the browser fetches.
PUBLIC_HOST=192.168.1.50

# Port MediaMTX serves HLS on (see config/mediamtx.template.yml).
MEDIAMTX_HLS_PORT=8888

# Port the FastAPI app listens on.
APP_PORT=8000

# Optional HTTP Basic auth for the web UI. Leave both unset to disable.
# Note: this is cleartext without TLS in front of it - "better than nothing," not real security.
#BASIC_AUTH_USER=
#BASIC_AUTH_PASS=
